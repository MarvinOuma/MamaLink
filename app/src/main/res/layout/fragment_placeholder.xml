<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="24dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/placeholder_badge" android:textColor="?attr/colorPrimary"
            android:textAppearance="?attr/textAppearanceOverline" />
        <TextView android:id="@+id/placeholder_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceHeadline5" />
        <TextView android:id="@+id/placeholder_description" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBody1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/placeholder_footer"
            android:textAppearance="?attr/textAppearanceBody2" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
